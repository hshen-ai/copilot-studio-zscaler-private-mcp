# Non-secret parameters for every script in this repository.
# Copy to config/demo.env and fill in. Every example value is a real value from the reference lab with
# its middle MASKED, so you can see the exact format; the comment above each key names the generic
# placeholder and where to find your own value.

# ---------------------------------------------------------------- Azure (hosting of the MCP server)
# <AZ_SUBSCRIPTION_ID> — Azure portal > Subscriptions
AZ_SUBSCRIPTION_ID=2c60xxxx-xxxx-xxxx-xxxx-xxxxxxxx66ce
# <AZ_RESOURCE_GROUP> — created by azure/01-network.sh if it does not exist
AZ_RESOURCE_GROUP=hwa-mcp-rg
# <AZ_LOCATION> — must be an Azure region of your Power Platform environment's geography
#   (Power Platform geo "switzerland" -> switzerlandnorth / switzerlandwest)
AZ_LOCATION=switzerlandnorth
# <AZ_PAIRED_LOCATION> — the paired region. Microsoft documents a delegated subnet in BOTH regions; the
#   reference lab could not create one (switzerlandwest is a restricted region) and the single-region
#   policy was accepted. Leave empty to skip; set it if your subscription can deploy there.
AZ_PAIRED_LOCATION=
# Address plan (any private ranges that do not overlap your other networks)
VNET_NAME=hwa-chn-vnet
VNET_PREFIX=10.60.0.0/16
PP_SUBNET_PREFIX=10.60.1.0/24
ACA_SUBNET_PREFIX=10.60.2.0/27
TEST_SUBNET_PREFIX=10.60.3.0/28
PAIRED_VNET_PREFIX=10.61.0.0/16
PAIRED_PP_SUBNET_PREFIX=10.61.1.0/24

# ---------------------------------------------------------------- Zscaler Internet Access (egress)
# <ZIA_PROXY> — your ZIA explicit proxy, host:port: a public Service Edge near the Azure region, or
#   gateway.<zscaler-cloud>.net:80. The NAT gateway's public IP (printed by azure/01-network.sh) must be
#   a Static IP + Location in ZIA, or ZIA refuses the CONNECT with 403.
ZIA_PROXY=z**1.s*e.z**********e.net:80
# <CA_BUNDLE> — PEM bundle (public roots + your Zscaler root CA) used by these scripts on YOUR machine
#   when it sits behind ZIA SSL inspection. Empty = system trust store.
CA_BUNDLE=
# <ZSCALER_ROOT_CA> — the Zscaler root CA (PEM) baked into the MCP server image so it can talk through
#   SSL inspection. ZIA Admin Portal > Policy > SSL Inspection > Download Zscaler Root Certificate.
ZSCALER_ROOT_CA=config/zscaler-root-ca.crt

# ---------------------------------------------------------------- Power Platform / Copilot Studio
# <TENANT_ID> — Entra admin center > Overview > Tenant ID
TENANT_ID=cddbxxxx-xxxx-xxxx-xxxx-xxxxxxxxf7c6
# <PP_ENVIRONMENT_ID> — Power Platform admin center > Manage > Environments > (yours) > Environment ID
#   The default environment's id is "Default-<TENANT_ID>".
PP_ENVIRONMENT_ID=Default-cddbxxxx-xxxx-xxxx-xxxx-xxxxxxxxf7c6
# <PP_GEO> — the environment's Power Platform geography (lower case), used for the enterprise policy
PP_GEO=switzerland
# <DATAVERSE_URL> — the environment's Dataverse URL: Power Platform admin center > Environment URL
DATAVERSE_URL=https://o*********3.crm17.dynamics.com
# <AGENT_SCHEMA> — schema name of the agent: <publisher prefix>_<name>. The prefix comes from the
#   environment's default publisher (Power Apps > Solutions > Publishers), e.g. cr000.
AGENT_SCHEMA=cr000_helloworldclassic
# <AGENT_NAME> — display name; keep the quotes (the file is also read by bash)
AGENT_NAME="Hello World Agent (Classic)"
# <BILLING_POLICY_NAME> — name of the pay-as-you-go billing policy (10-64 chars, A-Z and 0-9 only)
BILLING_POLICY_NAME=HWAPAYG001

# ---------------------------------------------------------------- Zscaler AI Guard (DAS API)
# <AIGUARD_BASE> — AI Guard Detection-as-a-Service base URL for your cloud
AIGUARD_BASE=https://api.zseclipse.net
# <AIGUARD_POLICY_ID> — numeric id of the AI Guard policy used by the MCP server's tool scans
#   AI Guard console > Policies. The Copilot Studio topics use resolve-and-execute-policy instead, so
#   AI Guard's match rules choose the policy there.
AIGUARD_POLICY_ID=27xx

# ---------------------------------------------------------------- Signed-in end-to-end test
# <TESTER_CLIENT_ID> — app registration created by copilot-studio/00-tester-app.sh (public client with
#   the delegated CopilotStudio.Copilots.Invoke permission)
TESTER_CLIENT_ID=03d3xxxx-xxxx-xxxx-xxxx-xxxxxxxx934a
