# Secrets. Copy to config/secrets.env, fill in, chmod 600. Never commit (it is in .gitignore).
# Only the SHAPE of each value is shown; no real character of any secret appears in this repository.
# The scripts read these values into Azure Container Apps secrets or a Power Platform connection
# without printing them.

# <TAVILY_API_KEY> — https://app.tavily.com > API Keys. Starts with "tvly-".
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# <AIGUARD_API_KEY> — AI Guard console > API keys (the Detection-as-a-Service key). 43 characters.
AIGUARD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
